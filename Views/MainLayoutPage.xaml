<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:NearFind.Views"
             x:Class="NearFind.Views.MainLayoutPage"
             Title="MainLayoutPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/MainLayoutStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,100">

        <!-- Main Content -->
        <ContentView Grid.Row="0" BackgroundColor="Transparent" />

        <view:BotNavBar Grid.Row="1"></view:BotNavBar>
        
    </Grid>
</ContentPage>