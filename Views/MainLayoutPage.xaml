<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NearFind.Views.MainLayoutPage"
             Title="MainLayoutPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/MainLayoutStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="100,*,100">

        <HorizontalStackLayout Grid.Row="0" Spacing="20" BackgroundColor="White" Padding="10">
            <Image Source="avatar.jpg" WidthRequest="80" HeightRequest="80" Aspect="AspectFit">
                <Image.Clip>
                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40" />
                </Image.Clip>
            </Image>
            <Label Text="Welcome User!" FontSize="24" TextColor="Black" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Center Content -->
        <ContentView Grid.Row="1" BackgroundColor="Transparent" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Padding="10, 10, 10, 10" Background="White">
            <ImageButton x:Name="HomeButton" Source="home_icon.png" Grid.Column="0"></ImageButton>
            <ImageButton x:Name="CompareButton" Source="compare_icon.png" Grid.Column="1"></ImageButton>
            <ImageButton x:Name="CartButton" Source="cart_icon.png" Grid.Column="2"></ImageButton>
            <ImageButton x:Name="FavouritesButton" Source="favourites_icon.png" Grid.Column="3"></ImageButton>
        </Grid>
    </Grid>
</ContentPage>